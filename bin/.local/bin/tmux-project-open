#!/usr/bin/env -S execlineb -W

# Create and open/switch to a session in Tmux.
#
#     $ tmux-project-open ~/Projects/dotfiles  (open new or existing session)
#     $ tmux-project-open ~/Documents docs     (as above but with custom name)
#     $ tmux-project-open . docs               (open existing session by name)

importas -i dir 1
if { test -d $dir }

backtick -E name {
    # If a name was provided, use it.
    ifelse { eltest -v 2 } { importas name 2 echo $name }
    # Home directory, use special name.
    ifelse { importas home HOME test $dir = $home } { echo ">_ " }
    # Else, take the basename and modify it for Tmux.
    pipeline { basename $dir } tr . _
}

# If no Tmux session exists, create one.
foreground {
    if -n { redirfd -w 2 /dev/null tmux has-session -t $name }
    tmux new-session -ds $name -c $dir
}

# Switch or attach to the session.
importas tmux TMUX
ifte { tmux switch-client -t $name } { tmux attach-session -t $name } test -n $tmux
