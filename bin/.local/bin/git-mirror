#!/usr/bin/env -S execlineb -W

# Reads from `.gitmirror` file (or a specified alternate) where each line is a
# Git remote URL.  Then mirrors from the first remote to the remaining ones.
#
# Example file:
#
#   ssh://git@codeberg.org/axvr/example.git
#   git@git.sr.ht:~axvr/example
#   git@github.com:axvr/example.git

importas -i home HOME
importas -D "${home}/.local/state" state_dir XDG_STATE_HOME
define mirror_dir "${state_dir}/git-mirror"

backtick -E mirror_file
{
    importas -D ".gitmirror" mirror_file 1
    realpath $mirror_file
}

# Converts `/` into `%` like Vim does with undo files.
backtick -E mirror_name
{
    pipeline { echo $mirror_file }
    sed -e "s,%,%%,g" -e "s,/,%,g"
}
define repo "${mirror_dir}/${mirror_name}"

foreground { echo "> Local mirror: \"${repo}\"" }

backtick -E fetch_remote { head -n 1 $mirror_file }

ifthenelse { test -d $repo }
{ git -C $repo remote set-url origin $fetch_remote }
{ git clone --mirror --origin=origin -- $fetch_remote $repo }

foreground { echo "> Fetching from: \"${fetch_remote}\"" }
foreground { git -C $repo remote update origin }

foreground { echo "> Cleaning and checking..." }
foreground { git -C $repo gc }
foreground { git -C $repo fsck --strict }

pipeline { tail -n +2 $mirror_file }
forstdin -E push_remote
foreground { echo "> Mirroring to: \"${push_remote}\"" }
git -C $repo push --mirror --atomic -- $push_remote
