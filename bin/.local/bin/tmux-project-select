#!/usr/bin/env -S execlineb -W

# Tmux project switcher.  Switch to and open projects as Tmux sessions.
# Provide a base directory to search for projects in as the first arg.

importas base 1

if { test -d $base }

backtick -E dir_name {
    cd $base
    pipeline { find . -maxdepth 3 -type d -name ".git" }
    pipeline { sed -e "s,^\./,," -e "s,/.git$,," }
    pipeline { sort }
    fzy --show-info --lines=100
}

if -n { test -z $dir_name }

tmux-project-open ${base}/${dir_name}
